# GameTalk 生产部署环境变量（复制为 .env 使用，生产必须修改）
# 生成强随机值：openssl rand -hex 32 / openssl rand -hex 16

# JWT 签名密钥（必改）
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# PostgreSQL 密码（必改）
POSTGRES_PASSWORD=change-me-db-password

# 域名（已解析到服务器，Caddy 自动申请证书）
GAMETALK_HOST=chat.example.com

# CORS 允许来源（可选，默认 *。桌面客户端不受浏览器同源限制，一般无需设置；
# 多个来源用逗号分隔，如 https://a.com,https://b.com）
# CORS_ORIGIN=*

# TURN 中继（可选）：自建 coturn（use-auth-secret 模式）后配置，供跨网络屏幕共享兜底。
# 密钥只存服务端，/api/turn 会为登录用户签发 1 小时限时凭据；不配置则客户端仅用 STUN（跨网受限网络可能连不上）。
# TURN_URL 可多个，逗号分隔（建议同时给 UDP 与 TCP）
# TURN_SECRET=change-me-openssl-rand-hex-16
# TURN_URL=turn:你的服务器IP:3478,turn:你的服务器IP:3478?transport=tcp
