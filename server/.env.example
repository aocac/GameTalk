# GameTalk Server 环境变量
# 复制为 .env 后按需修改。所有值都有默认值（见 src/config.ts）。

# HTTP/WS 监听
HOST=0.0.0.0
PORT=8787

# 生产：PostgreSQL 连接串（设置了 DATABASE_URL 则使用真实 PostgreSQL）
# 开发：不设置则使用 PGlite 内存数据库（零依赖，数据不持久）
DATABASE_URL=postgres://gametalk:gametalk@localhost:5432/gametalk

# JWT 密钥（生产必须替换为长随机串！）
JWT_SECRET=change-me-to-a-long-random-string

# JWT 有效期
JWT_EXPIRES_IN=7d

# CORS 允许的客户端来源（开发可用 *）
CORS_ORIGIN=*

# 日志级别
LOG_LEVEL=info

# 运行环境：development / production / test（production 关闭请求日志）
NODE_ENV=development

# PGlite 数据目录（仅在未设置 DATABASE_URL 的本地开发模式下生效）
PGLITE_DATA_DIR=data/gametalk.pglite

# REST 限流：全局每分钟上限 / 注册登录每分钟上限
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# 自建 TURN（coturn）凭据签发：不设置则 /api/turn 返回空列表（客户端仅用 STUN）
# TURN_SECRET 必须与 coturn 的 static-auth-secret 一致，只存服务端，绝不进客户端/仓库
# TURN_SECRET=change-me
# TURN_URL=turn:your-host:3478?transport=tcp
# 走中继时的单路码率上限（bps，默认 1200000）。按服务器出口带宽设置：
# 4Mbps 出口建议 1200000；30Mbps 出口可设 4000000
# TURN_RELAY_MAX_BPS=1200000
