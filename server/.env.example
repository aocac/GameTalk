# GameTalk Server 环境变量
# 复制为 .env 后按需修改。所有值都有默认值（见 src/config.ts）。

# HTTP/WS 监听
HOST=0.0.0.0
PORT=8787

# 生产：PostgreSQL 连接串（设置了 DATABASE_URL 则使用真实 PostgreSQL）
# 开发：不设置则使用 PGlite 内存数据库（零依赖，数据不持久）
DATABASE_URL=postgres://gametalk:gametalk@localhost:5432/gametalk

# JWT 密钥（生产必须替换为长随机串！）
JWT_SECRET=change-me-to-a-long-random-string

# JWT 有效期
JWT_EXPIRES_IN=7d

# CORS 允许的客户端来源（开发可用 *）
CORS_ORIGIN=*

# 日志级别
LOG_LEVEL=info
