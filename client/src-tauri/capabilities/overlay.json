{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay-windows",
  "description": "Capabilities for the input and message overlay windows",
  "windows": ["input", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-ignore-cursor-events",
    "core:event:default"
  ]
}
