{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "input",
  "description": "Capability for the game input window",
  "windows": [
    "input"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-outer-position"
  ]
}
